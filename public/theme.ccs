/* Sibiya AI theme for the static pages (About, Support, Privacy). */

html {
  background: linear-gradient(180deg, #1A120A 0%, #271C0F 55%, #3D3220 100%) fixed;
  min-height: 100%;
}

body {
  background: transparent;
  color: #F3E6CC;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(26, 18, 10, 1) 0%, rgba(26, 18, 10, 0.94) 28%, rgba(26, 18, 10, 0.72) 60%, rgba(26, 18, 10, 0.6) 100%),
    url("/bg.jpg") center bottom / cover no-repeat;
}

/* parchment text */
p, li, .lead, .avail, .ans p, .ans li {
  color: #E2CEB1;
}
.tagline, .muted, .foot-blurb {
  color: #B5A284;
}
.foot-name, .foot-cols a {
  color: #F3E6CC;
}
.foot-bar, .updated {
  color: #94816A;
}

/* warm brown surfaces */
details, .card {
  background: rgba(39, 28, 15, 0.88);
  border-color: rgba(226, 206, 177, 0.2);
  border-left-color: #A13D2D;
}
details {
  border-left-color: rgba(226, 206, 177, 0.2);
}
details[open] {
  border-color: rgba(201, 164, 76, 0.5);
}
.note {
  background: rgba(20, 13, 7, 0.7);
}
.mark {
  background: rgba(39, 28, 15, 0.88);
}

/* parchment lines */
.ans {
  border-top-color: rgba(226, 206, 177, 0.14);
}
.site-foot {
  border-top-color: rgba(226, 206, 177, 0.2);
}
.foot-bar, .updated {
  border-top-color: rgba(226, 206, 177, 0.14);
}
